# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=Your_password
DB_NAME=Your_DB_name

# --- JWT ---
JWT_ACCESS_SECRET=Your-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Argon2 (password hashing cost) ---
# Strong values for production. Lowered automatically in NODE_ENV=test (see src/config/argon2.config.ts)
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

NODE_ENV=development
PORT=3000

# --- Security (Assignment 3) ---
# Origin allowed to call this API with credentials. Never a wildcard.
CORS_ORIGIN=http://localhost:3000
# Requests per 60s window allowed on /auth/register, /auth/login,
# /auth/refresh, tracked per IP. Automatically raised under NODE_ENV=test
# so the functional test suites don't trip it on ordinary traffic.
AUTH_THROTTLE_LIMIT=5
